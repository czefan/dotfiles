{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "chezmoi: Auto-sync on Open & Save",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-NoLogo",
                "-File",
                "${workspaceFolder}/.vscode/sync-watch.ps1"
            ],
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen",
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
